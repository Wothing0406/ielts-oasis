{
  "manifest_version": 3,
  "name": "Mát Cha AI Eo Mascot Study Buddy",
  "version": "1.0",
  "description": "Trợ lý học thuật cá nhân hóa, nhắc nhở từ vựng định kỳ qua Mascot Matcha Pixel 2D 1x1 và đồng bộ đa kênh.",
  "permissions": [
    "activeTab",
    "storage",
    "alarms",
    "sidePanel",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "https://ieltsoasis.site/*"
  ],
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/assistant.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content_scripts/ocr_selector.js",
        "content_scripts/pet_overlay.js",
        "content_scripts/text_highlighter.js"
      ],
      "css": ["content_scripts/pet_overlay.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/mascot/*",
        "assets/icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
